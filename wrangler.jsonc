{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daypact",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-19",
  "account_id": "fd0552315586fdcf384c51efec740e8e",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daypact",
      "database_id": "222fd9fe-f67c-41ae-82c6-52d84f92c45e",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "daypact-8dd4b",
    "FIREBASE_WEB_API_KEY": "AIzaSyB7ECQvROphOI6eldhQJfdDqppXSGYs7Uc",
    "APP_ORIGIN": "https://daypact.vertex-blip.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
